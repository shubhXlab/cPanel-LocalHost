/* ==========================================================================
   cPanel Jupiter Theme Stylesheet (Localhost Edition)
   ========================================================================== */

:root {
  --cp-orange: #ff6c2c;
  --cp-orange-dark: #e05619;
  --cp-orange-light: #fff2eb;
  --cp-navy-dark: #0f172a;
  --cp-navy: #1e293b;
  --cp-navy-light: #334155;
  --cp-bg: #f8fafc;
  --cp-card-bg: #ffffff;
  --cp-border: #e2e8f0;
  --cp-border-dark: #cbd5e1;
  --cp-text: #1e293b;
  --cp-text-muted: #64748b;
  --cp-primary: #2563eb;
  --cp-success: #10b981;
  --cp-warning: #f59e0b;
  --cp-danger: #ef4444;
  --cp-info: #0ea5e9;
  --cp-radius: 8px;
  --cp-shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --cp-shadow-lg: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
  --font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-family);
  background-color: var(--cp-bg);
  color: var(--cp-text);
  font-size: 14px;
  line-height: 1.5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

a {
  color: var(--cp-primary);
  text-decoration: none;
}
a:hover {
  text-decoration: underline;
}

/* ==========================================================================
   Login Page Styling
   ========================================================================== */

.login-body {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.login-container {
  width: 100%;
  max-width: 440px;
  margin: auto;
}

.login-header {
  text-align: center;
  margin-bottom: 25px;
}

.login-logo {
  font-size: 38px;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.cpanel-orange {
  color: var(--cp-orange);
}

.cpanel-edition {
  color: #94a3b8;
  font-size: 16px;
  font-weight: 600;
  margin-left: 6px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.login-tagline {
  color: #94a3b8;
  font-size: 14px;
  margin-top: 4px;
}

.login-card {
  background: var(--cp-card-bg);
  border-radius: 12px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.2);
  padding: 32px 28px;
  border: 1px solid #334155;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  margin-bottom: 6px;
  font-weight: 600;
  color: #334155;
  font-size: 13px;
}

.form-group label i {
  color: var(--cp-orange);
  margin-right: 6px;
}

.input-wrapper {
  position: relative;
}

.form-control {
  width: 100%;
  height: 42px;
  padding: 8px 14px;
  border: 1px solid var(--cp-border-dark);
  border-radius: var(--cp-radius);
  font-size: 14px;
  font-family: inherit;
  color: var(--cp-text);
  background-color: #ffffff;
  transition: all 0.2s;
}

.form-control:focus {
  outline: none;
  border-color: var(--cp-orange);
  box-shadow: 0 0 0 3px rgba(255, 108, 44, 0.15);
}

.password-wrapper {
  display: flex;
}

.password-wrapper .form-control {
  padding-right: 42px;
}

.btn-icon {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--cp-text-muted);
  cursor: pointer;
  padding: 6px;
}
.btn-icon:hover {
  color: var(--cp-orange);
}

.login-options {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
  font-size: 13px;
}

.checkbox-container {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  color: #475569;
}

.btn-primary {
  background-color: var(--cp-orange);
  color: #ffffff;
  border: none;
  border-radius: var(--cp-radius);
  font-weight: 700;
  font-size: 15px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s;
}

.btn-primary:hover {
  background-color: var(--cp-orange-dark);
}

.btn-block {
  width: 100%;
  height: 44px;
}

.login-credentials-hint {
  margin-top: 20px;
  background-color: #f8fafc;
  border: 1px dashed var(--cp-border-dark);
  border-radius: var(--cp-radius);
  padding: 10px 14px;
  font-size: 12px;
  color: var(--cp-text-muted);
  display: flex;
  align-items: center;
  gap: 8px;
}

.login-credentials-hint i {
  color: var(--cp-info);
  font-size: 14px;
}

.login-footer {
  margin-top: 25px;
  text-align: center;
  color: #94a3b8;
  font-size: 12px;
}

.locale-select {
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.locale-select select {
  background: transparent;
  color: #94a3b8;
  border: 1px solid #475569;
  border-radius: 4px;
  padding: 4px 8px;
  font-size: 12px;
  outline: none;
}

/* ==========================================================================
   Main cPanel App Navigation & Top Header
   ========================================================================== */

.cp-header {
  background-color: var(--cp-navy-dark);
  color: #ffffff;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.cp-header-left {
  display: flex;
  align-items: center;
  gap: 20px;
}

.cp-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 24px;
  font-weight: 800;
  text-decoration: none;
}

.cp-brand-tag {
  background-color: #334155;
  color: #38bdf8;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
  text-transform: uppercase;
}

/* Service Badges in Header */
.cp-service-badges {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-left: 10px;
}

.service-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  background-color: #1e293b;
  border: 1px solid #334155;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 12px;
  color: #cbd5e1;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.status-dot.online { background-color: #10b981; box-shadow: 0 0 6px #10b981; }
.status-dot.offline { background-color: #ef4444; }

.badge-btn {
  background: none;
  border: none;
  color: #94a3b8;
  cursor: pointer;
  font-size: 11px;
  margin-left: 4px;
  padding: 2px;
}
.badge-btn:hover {
  color: var(--cp-orange);
}

/* Live Search Filter */
.cp-header-center {
  flex: 1;
  max-width: 500px;
  margin: 0 24px;
}

.cp-search-box {
  position: relative;
  width: 100%;
}

.cp-search-box i {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
  font-size: 14px;
}

.cp-search-box input {
  width: 100%;
  height: 38px;
  background-color: #1e293b;
  border: 1px solid #334155;
  border-radius: 20px;
  padding: 6px 16px 6px 38px;
  color: #ffffff;
  font-size: 13px;
  outline: none;
  transition: all 0.2s;
}

.cp-search-box input:focus {
  border-color: var(--cp-orange);
  background-color: #0f172a;
  box-shadow: 0 0 0 2px rgba(255, 108, 44, 0.2);
}

.cp-header-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.cp-header-icon-btn {
  background: none;
  border: none;
  color: #cbd5e1;
  font-size: 16px;
  cursor: pointer;
  position: relative;
  padding: 6px;
}
.cp-header-icon-btn:hover {
  color: #ffffff;
}

.icon-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: var(--cp-orange);
  color: #ffffff;
  font-size: 10px;
  font-weight: 700;
  padding: 2px 5px;
  border-radius: 10px;
}

.cp-user-menu {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  padding: 6px 12px;
  border-radius: 6px;
  transition: background-color 0.2s;
}
.cp-user-menu:hover {
  background-color: #334155;
}

.user-avatar {
  width: 32px;
  height: 32px;
  background-color: var(--cp-orange);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 14px;
}

.user-name {
  font-weight: 600;
  font-size: 13px;
  color: #f1f5f9;
}

/* User Dropdown */
.dropdown-menu {
  position: absolute;
  right: 24px;
  top: 55px;
  background: #ffffff;
  border: 1px solid var(--cp-border);
  border-radius: var(--cp-radius);
  box-shadow: var(--cp-shadow-lg);
  min-width: 200px;
  display: none;
  flex-direction: column;
  z-index: 1010;
  overflow: hidden;
}
.dropdown-menu.active {
  display: flex;
}

.dropdown-item {
  padding: 10px 16px;
  color: var(--cp-text);
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  transition: background-color 0.15s;
}
.dropdown-item:hover {
  background-color: #f1f5f9;
  text-decoration: none;
}
.dropdown-item i {
  color: var(--cp-text-muted);
  width: 16px;
}

.dropdown-divider {
  height: 1px;
  background-color: var(--cp-border);
}

/* Sub-nav / Breadcrumbs */
.cp-subnav {
  background-color: #ffffff;
  border-bottom: 1px solid var(--cp-border);
  padding: 10px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cp-breadcrumbs {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--cp-text-muted);
  font-size: 13px;
}
.cp-breadcrumbs a {
  color: var(--cp-text-muted);
  display: flex;
  align-items: center;
  gap: 4px;
}
.cp-breadcrumbs a:hover {
  color: var(--cp-orange);
}

.cp-quick-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-secondary {
  background-color: #ffffff;
  border: 1px solid var(--cp-border-dark);
  color: #334155;
  padding: 6px 12px;
  border-radius: var(--cp-radius);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.15s;
}
.btn-secondary:hover {
  background-color: #f8fafc;
  border-color: #94a3b8;
}

/* ==========================================================================
   Main Dashboard Layout (Two Columns)
   ========================================================================== */

.cp-layout {
  display: flex;
  gap: 24px;
  padding: 24px;
  max-width: 1600px;
  margin: 0 auto;
  width: 100%;
}

.cp-main-content {
  flex: 1;
  min-width: 0;
}

.cp-sidebar {
  width: 320px;
  flex-shrink: 0;
}

/* Tool Categories & Accordions */
.category-card {
  background: var(--cp-card-bg);
  border: 1px solid var(--cp-border);
  border-radius: var(--cp-radius);
  margin-bottom: 20px;
  box-shadow: var(--cp-shadow);
  overflow: hidden;
}

.category-header {
  background-color: #f8fafc;
  border-bottom: 1px solid var(--cp-border);
  padding: 12px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  user-select: none;
}

.category-title {
  font-weight: 700;
  font-size: 14px;
  color: #1e293b;
  display: flex;
  align-items: center;
  gap: 10px;
}

.category-title i {
  color: var(--cp-orange);
  font-size: 15px;
}

.category-toggle {
  color: var(--cp-text-muted);
  transition: transform 0.2s;
}
.category-card.collapsed .category-toggle {
  transform: rotate(-90deg);
}
.category-card.collapsed .category-content {
  display: none;
}

.category-content {
  padding: 18px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 16px;
}

/* Tool Tiles */
.tool-tile {
  background: #ffffff;
  border: 1px solid transparent;
  border-radius: var(--cp-radius);
  padding: 16px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
  text-decoration: none;
  color: var(--cp-text);
}

.tool-tile:hover {
  background-color: #f8fafc;
  border-color: var(--cp-border-dark);
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0,0,0,0.05);
  text-decoration: none;
}

.tool-icon {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  background-color: var(--cp-orange-light);
  color: var(--cp-orange);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  margin-bottom: 10px;
  transition: all 0.2s;
}

.tool-tile:hover .tool-icon {
  background-color: var(--cp-orange);
  color: #ffffff;
}

.tool-name {
  font-size: 12px;
  font-weight: 600;
  color: #334155;
  line-height: 1.3;
}

/* ==========================================================================
   Right Statistics Sidebar
   ========================================================================== */

.sidebar-card {
  background: var(--cp-card-bg);
  border: 1px solid var(--cp-border);
  border-radius: var(--cp-radius);
  margin-bottom: 20px;
  box-shadow: var(--cp-shadow);
  overflow: hidden;
}

.sidebar-header {
  background-color: #f8fafc;
  border-bottom: 1px solid var(--cp-border);
  padding: 12px 16px;
  font-weight: 700;
  font-size: 13px;
  color: #1e293b;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sidebar-body {
  padding: 16px;
}

.info-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
  font-size: 12px;
  border-bottom: 1px dashed #f1f5f9;
  padding-bottom: 6px;
}
.info-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.info-label {
  color: var(--cp-text-muted);
  font-weight: 500;
}

.info-value {
  color: #0f172a;
  font-weight: 600;
  text-align: right;
}

/* Statistics Progress Bars */
.stat-item {
  margin-bottom: 16px;
}
.stat-item:last-child {
  margin-bottom: 0;
}

.stat-header {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  margin-bottom: 5px;
}

.stat-title {
  font-weight: 600;
  color: #334155;
}

.stat-val {
  color: var(--cp-text-muted);
}

.progress-bar-container {
  width: 100%;
  height: 8px;
  background-color: #e2e8f0;
  border-radius: 4px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background-color: var(--cp-primary);
  border-radius: 4px;
  transition: width 0.4s ease;
}

.progress-bar-fill.warning { background-color: var(--cp-warning); }
.progress-bar-fill.danger { background-color: var(--cp-danger); }
.progress-bar-fill.success { background-color: var(--cp-success); }

/* ==========================================================================
   Modals & Overlays
   ========================================================================== */

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(3px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  padding: 20px;
}
.modal-overlay.active {
  display: flex;
}

.modal-container {
  background: #ffffff;
  border-radius: 12px;
  width: 100%;
  max-width: 900px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: var(--cp-shadow-lg);
  border: 1px solid var(--cp-border);
  overflow: hidden;
  animation: modalIn 0.2s ease-out;
}

.modal-container.modal-lg {
  max-width: 1200px;
}

.modal-container.modal-full {
  max-width: 96vw;
  height: 92vh;
}

@keyframes modalIn {
  from { opacity: 0; transform: scale(0.97); }
  to { opacity: 1; transform: scale(1); }
}

.modal-header {
  padding: 16px 22px;
  background-color: #f8fafc;
  border-bottom: 1px solid var(--cp-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  font-size: 16px;
  font-weight: 700;
  color: #1e293b;
  display: flex;
  align-items: center;
  gap: 10px;
}
.modal-title i {
  color: var(--cp-orange);
}

.modal-close {
  background: none;
  border: none;
  color: #94a3b8;
  font-size: 18px;
  cursor: pointer;
  padding: 4px;
}
.modal-close:hover {
  color: #ef4444;
}

.modal-body {
  padding: 22px;
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  padding: 14px 22px;
  background-color: #f8fafc;
  border-top: 1px solid var(--cp-border);
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

/* ==========================================================================
   Tables & Data Presentation
   ========================================================================== */

.cp-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin-top: 10px;
}

.cp-table th {
  background-color: #f8fafc;
  border-bottom: 2px solid var(--cp-border);
  padding: 10px 12px;
  text-align: left;
  font-weight: 700;
  color: #475569;
}

.cp-table td {
  padding: 10px 12px;
  border-bottom: 1px solid var(--cp-border);
  color: #1e293b;
}

.cp-table tr:hover td {
  background-color: #f8fafc;
}

/* Buttons */
.btn-sm {
  padding: 4px 10px;
  font-size: 12px;
  border-radius: 4px;
}

.btn-danger {
  background-color: #fee2e2;
  color: #ef4444;
  border: 1px solid #fecaca;
  cursor: pointer;
  font-weight: 600;
}
.btn-danger:hover {
  background-color: #ef4444;
  color: #ffffff;
}

.btn-success {
  background-color: #dcfce7;
  color: #15803d;
  border: 1px solid #bbf7d0;
  cursor: pointer;
  font-weight: 600;
}
.btn-success:hover {
  background-color: #16a34a;
  color: #ffffff;
}

/* ==========================================================================
   File Manager Toolbar & Layout
   ========================================================================== */

.fm-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f8fafc;
  border: 1px solid var(--cp-border);
  border-radius: var(--cp-radius);
  padding: 8px 14px;
  margin-bottom: 14px;
  gap: 8px;
  flex-wrap: wrap;
}

.fm-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.fm-path-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background-color: #ffffff;
  border: 1px solid var(--cp-border);
  border-radius: 6px;
  padding: 6px 12px;
  margin-bottom: 14px;
  font-size: 13px;
}

.fm-container {
  display: flex;
  gap: 16px;
  height: 520px;
}

.fm-tree-panel {
  width: 240px;
  background-color: #ffffff;
  border: 1px solid var(--cp-border);
  border-radius: var(--cp-radius);
  padding: 12px;
  overflow-y: auto;
  font-size: 13px;
}

.fm-file-panel {
  flex: 1;
  background-color: #ffffff;
  border: 1px solid var(--cp-border);
  border-radius: var(--cp-radius);
  overflow-y: auto;
}

.file-row {
  cursor: pointer;
}
.file-row.selected {
  background-color: #eff6ff !important;
}

/* ==========================================================================
   Terminal Window
   ========================================================================== */

.terminal-window {
  background-color: #0b0f19;
  color: #10b981;
  font-family: 'Consolas', 'Courier New', monospace;
  font-size: 13px;
  border-radius: 8px;
  padding: 16px;
  height: 480px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.terminal-history {
  flex: 1;
  overflow-y: auto;
  white-space: pre-wrap;
  line-height: 1.4;
  margin-bottom: 10px;
}

.terminal-prompt-line {
  display: flex;
  align-items: center;
  gap: 8px;
}

.terminal-prompt {
  color: #38bdf8;
  font-weight: bold;
}

.terminal-input {
  flex: 1;
  background: transparent;
  border: none;
  color: #f8fafc;
  font-family: inherit;
  font-size: inherit;
  outline: none;
}

/* ==========================================================================
   Privilege Checkbox Grid
   ========================================================================== */

.privileges-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 10px;
  margin: 16px 0;
  background-color: #f8fafc;
  border: 1px solid var(--cp-border);
  border-radius: var(--cp-radius);
  padding: 16px;
}

.privilege-label {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  color: #334155;
}

/* Toast Notifications */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 3000;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.toast {
  background: #ffffff;
  border-left: 4px solid var(--cp-orange);
  border-radius: 6px;
  box-shadow: var(--cp-shadow-lg);
  padding: 12px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 280px;
  max-width: 400px;
  font-size: 13px;
  animation: toastIn 0.3s ease-out;
}

@keyframes toastIn {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

.toast.success { border-left-color: var(--cp-success); }
.toast.error { border-left-color: var(--cp-danger); }
.toast.info { border-left-color: var(--cp-info); }

.d-none { display: none !important; }

/* ==========================================================================
   MySQL Database Wizard & Remote MySQL Styles
   ========================================================================== */

.cp-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  margin-bottom: 28px;
  padding: 0 10px;
}

.cp-stepper::before {
  content: '';
  position: absolute;
  top: 18px;
  left: 30px;
  right: 30px;
  height: 3px;
  background-color: #e2e8f0;
  z-index: 1;
}

.cp-step {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  cursor: default;
}

.cp-step-num {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: #ffffff;
  border: 3px solid #cbd5e1;
  color: #64748b;
  font-weight: 700;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.cp-step.active .cp-step-num {
  border-color: var(--cp-primary);
  background-color: var(--cp-primary);
  color: #ffffff;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.18);
}

.cp-step.completed .cp-step-num {
  border-color: var(--cp-success);
  background-color: var(--cp-success);
  color: #ffffff;
}

.cp-step-label {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  white-space: nowrap;
}

.cp-step.active .cp-step-label {
  color: var(--cp-primary);
  font-weight: 700;
}

.cp-step.completed .cp-step-label {
  color: #1e293b;
}

.wizard-card {
  background: #ffffff;
  border: 1px solid var(--cp-border);
  border-radius: 10px;
  padding: 24px;
  box-shadow: var(--cp-shadow);
}

.credential-summary-card {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 14px;
  margin: 20px 0;
}

.credential-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 14px 16px;
  position: relative;
}

.credential-box .label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #64748b;
  font-weight: 700;
  margin-bottom: 4px;
}

.credential-box .value {
  font-family: 'Consolas', monospace;
  font-size: 14px;
  font-weight: 600;
  color: #1e293b;
  word-break: break-all;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.code-snippet-box {
  background: #0f172a;
  color: #e2e8f0;
  border-radius: 8px;
  padding: 16px;
  font-family: 'Consolas', 'Courier New', monospace;
  font-size: 12px;
  line-height: 1.6;
  position: relative;
  overflow-x: auto;
}

.code-snippet-box .copy-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  border: none;
  border-radius: 4px;
  padding: 4px 8px;
  font-size: 11px;
  cursor: pointer;
}
.code-snippet-box .copy-btn:hover {
  background: rgba(255, 255, 255, 0.25);
}

/* ==========================================================================
   cPanel Custom Right-Click Context Menu (Authentic cPanel Theme)
   ========================================================================== */

.cp-context-menu {
  position: fixed;
  z-index: 100000;
  background: #ffffff;
  border: 1px solid #b8b8b8;
  border-radius: 1px;
  box-shadow: 2px 3px 8px rgba(0, 0, 0, 0.28);
  min-width: 165px;
  max-width: 260px;
  padding: 3px 0;
  display: none;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  font-size: 13px;
  color: #000000;
  user-select: none;
  pointer-events: auto;
}

.cp-context-menu.active {
  display: flex;
}

.cp-context-item {
  display: flex;
  align-items: center;
  padding: 4px 16px 4px 10px;
  color: #000000;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  gap: 10px;
  line-height: 1.45;
}

.cp-context-item i {
  width: 16px;
  text-align: center;
  font-size: 13.5px;
  color: #000000;
}

.cp-context-item:hover {
  background-color: #eaf2fd;
  color: #0066cc;
}

.cp-context-item:hover i {
  color: #0066cc;
}


